{
  "name": "loja-recondicionados",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/*.test.ts src/ai/*.test.ts src/lib/*.test.ts",
    "test:db": "python3 supabase/tests/rls_test.py",
    "test:backend": "cd backend && python3 -m pytest -q",
    "e2e": "sh supabase/tests/run_e2e.sh",
    "verify": "npm run typecheck && npm test && npm run test:db && npm run test:backend && npm audit --omit=dev && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
